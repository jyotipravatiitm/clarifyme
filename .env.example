# ============================================================
# ClarifyMe configuration. Every block is optional; leave a block
# empty and that feature is simply switched off.
# ============================================================

# --- Deployment (docker compose) ---
DOMAIN=clarifyme.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Set automatically by docker-compose. For local dev without Docker:
# DATABASE_URL=postgres://postgres@localhost:5432/clarifyme

# --- Accounts (Clerk) ---
# https://dashboard.clerk.com → API keys. Without these, the app stays anonymous.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Lessons a guest can finish before signing up (needs Clerk + database). 0 = no limit.
FREE_LESSONS=10

# --- Google Analytics 4 ---
# Measurement id, e.g. G-XXXXXXXXXX. Empty = no analytics and no cookie banner.
NEXT_PUBLIC_GA_ID=
# opt-out: analytics on until the visitor opts out (default).
# opt-in:  analytics off until the visitor allows it (recommended for EU/UK visitors).
NEXT_PUBLIC_GA_CONSENT=opt-out

# --- Generative LLM (any OpenAI-compatible Chat Completions endpoint) ---
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Anthropic:   LLM_BASE_URL=https://api.anthropic.com/v1/
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Any model id your provider serves, e.g. an OpenRouter "vendor/model" id.
LLM_MODEL=
# Set to "json_object" if your provider does not support strict json_schema output.
LLM_RESPONSE_FORMAT=json_schema

# --- Jev (TypeSafe decision model on OpenRouter) ---
OPENROUTER_API_KEY=
JEV_MODEL=~typesafe/jev-latest
JEV_URL=https://openrouter.ai/api/alpha/decisions

# --- Limits ---
RATE_LIMIT_PER_MINUTE=30
